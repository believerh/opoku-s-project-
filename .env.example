# Copy to .env (never commit .env). On Railway, set these as service Variables instead (see DEPLOY.md).

NODE_ENV=production
PORT=3000

# Public address with no trailing slash. Optional on Railway (its generated domain is used if blank).
SITE_URL=http://localhost:3000

# MongoDB: Atlas string, your own server, or on Railway:  ${{MongoDB.MONGO_URL}}
# (Not needed for the Docker Compose setup; compose builds this for you.)
MONGODB_URI=mongodb+srv://joanairene100_db_user:7xZ46OFZTFksmZpK@cluster0.o3nofho.mongodb.net
# Optional database name, used when the connection string does not include one (default: okomfo_anokye)
MONGODB_DB=

# First-start administrator account. Make the hash with:  npm run hash -- "your-strong-password"
# Keep the single quotes; the hash contains $ characters. After the first start the password is managed
# inside the site (My account); to recover a lost password run:  npm run reset-admin -- you@example.com "NewPassword"
ADMIN_EMAIL=joanairene100@gmail.com
ADMIN_PASSWORD_HASH=$2b$12$apEpTLsvuhwvUBgZtqs.ieox0JCb1lIPOVqFkNKw.i7FnzaCfLESy
# Random secret, 32+ characters:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=$2b$12$apEpTLsvuhwvUBgZtqs.ieox0JCb1lIPOVqFkNKw.i7FnzaCfLESy

# Uploaded pictures/videos. Must be persistent storage. Optional on Railway (a volume is used automatically).
UPLOAD_DIR=./uploads

# DNS servers for reaching MongoDB Atlas. Set this if you see "querySrv/queryTxt ETIMEOUT" (Termux does this
# automatically). Example: 8.8.8.8,1.1.1.1
DNS_SERVERS=
# Set to 1 to turn picture resizing off (it turns itself off if the image library cannot load).
DISABLE_IMAGE_RESIZE=

# Number of reverse proxies in front of the app (nginx/Caddy/Railway = 1). Used for visitor IPs in rate limits.
TRUST_PROXY=1
# Extra website addresses allowed to log in and publish (comma-separated), e.g. a second domain.
ALLOWED_ORIGINS=*

# Push notifications (leave blank to switch them off). Make the keys with:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailt:joanairene100@gmail.com

# Brevo email (leave blank to switch email alerts off)
BREVO_API_KEY=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
MAIL_FROM_EMAIL=joanairene100@gmail.com
MAIL_FROM_NAME=Okomfo Anokye Updates

