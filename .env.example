# Copy to .env (never commit .env). On Railway, set these as service Variables instead (see DEPLOY.md).

NODE_ENV=production
PORT=3000

# Public address with no trailing slash. Optional on Railway (its generated domain is used if blank).
SITE_URL=https://your-school-site.example.com

# MongoDB: Atlas string, your own server, or on Railway:  ${{MongoDB.MONGO_URL}}
# (Not needed for the Docker Compose setup; compose builds this for you.)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/okomfo_anokye?retryWrites=true&w=majority
# Optional database name, used when the connection string does not include one (default: okomfo_anokye)
MONGODB_DB=

# Admin login. Make the hash with:  npm run hash -- "your-strong-password"
# Keep the single quotes; the hash contains $ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='$2b$12$REPLACE_WITH_OUTPUT_OF_npm_run_hash'
# Random secret, 32+ characters:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Uploaded pictures/videos. Must be persistent storage. Optional on Railway (a volume is used automatically).
UPLOAD_DIR=./uploads

# Number of reverse proxies in front of the app (nginx/Caddy/Railway = 1). Used for visitor IPs in rate limits.
TRUST_PROXY=1
# Extra website addresses allowed to log in and publish (comma-separated), e.g. a second domain.
ALLOWED_ORIGINS=

# Brevo email (leave blank to switch email alerts off)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Okomfo Anokye Updates

# --- Docker Compose (VPS) only ---
DOMAIN=your-school-site.example.com
MONGO_USER=oaadmin
MONGO_PASSWORD=
