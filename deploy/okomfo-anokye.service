# systemd service for a VPS without Docker.
# Install:  sudo cp deploy/okomfo-anokye.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now okomfo-anokye
# The app reads its settings from /opt/okomfo-anokye/.env by itself.
[Unit]
Description=Okomfo Anokye Updates
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oa
WorkingDirectory=/opt/okomfo-anokye
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
